# =============================================================================
# HOP Project - .gitignore
# Covers Java, Maven, Spring Boot, React, Node.js, Scratch, IDEs, OS, and Secrets
# =============================================================================

# --- Temporary & Scratch Workspace ---
scratch/
/scratch/
*.tmp
*.bak
*.swp
*~

# --- Environment & Credentials (NEVER commit secrets, keys, or passwords) ---
.env
.env.*
!.env.example
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.cer
*.crt
*.jks
credentials.json
secrets.properties
secrets.yaml
secrets.yml

# --- Compiled Java & Build Artifacts ---
*.class
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# --- Maven ---
target/
/backend/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
.locks/
*.lock

# --- Gradle (if used) ---
.gradle/
build/
!src/**/build/

# --- Database Data Directories & Local Storage ---
database/pg_data/
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.bak

# --- Spring Boot & Application Outputs ---
*.log
logs/
application-local.properties
application-local.yml
application-local.yaml
application-secret.properties
application-secret.yml
application-secret.yaml

# --- Uploaded User Documents, Avatars & Media ---
uploads/
/backend/uploads/
backend/uploads/**

# --- Node.js & React Dependencies & Build Output ---
node_modules/
/frontend/node_modules/
dist/
/frontend/dist/
.vite/
/frontend/.vite/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.eslintcache
.stylelintcache

# --- Test Coverage & Verification ---
coverage/
*.lcov
.nyc_output/

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- Visual Studio Code ---
.vscode/
*.code-workspace

# --- Eclipse ---
.apt_generated
.apt_generated_tests
.classpath
.factorypath
.project
.settings/
.springBeans

# --- NetBeans ---
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
[Dd]esktop.ini
$RECYCLE.BIN/


