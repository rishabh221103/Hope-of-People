# =============================================================================
# HOP (Humanitarian Operations Platform) - Comprehensive .gitignore
# Covers Java, Spring Boot, Maven, React, Node.js, Vite, Databases, Secrets, & OS
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS)
# -----------------------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
!.env.example
!**/.env.example

# Secrets, Keys & Certificates
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.cer
*.crt
*.jks
credentials.json
**/credentials.json
secrets.properties
secrets.yaml
secrets.yml
**/secrets.properties
**/secrets.yaml
**/secrets.yml
application-local.properties
application-local.yml
application-local.yaml
application-secret.properties
application-secret.yml
application-secret.yaml

# -----------------------------------------------------------------------------
# 2. Uploaded Media, Documents & Local Storage (User data)
# -----------------------------------------------------------------------------
uploads/
**/uploads/
backend/uploads/
uploads/**
backend/uploads/**
uploads/documents/
uploads/reels/

# Database Local Storage & Dumps
database/pg_data/
**/pg_data/
pg_data/
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.bak

# Scratch Workspace & Temporary Verification Scripts
scratch/
/scratch/
**/scratch/

# -----------------------------------------------------------------------------
# 3. Java & Maven Build Artifacts (Backend)
# -----------------------------------------------------------------------------
target/
**/target/
*.class
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven specific
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
.locks/
*.lock
!package-lock.json

# Gradle (if used)
.gradle/
**/build/
!src/**/build/

# -----------------------------------------------------------------------------
# 4. Node.js & React Build Artifacts (Frontend)
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
.npm/
.pnpm-store/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Node debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage outputs
coverage/
**/coverage/
*.lcov
.nyc_output/

# -----------------------------------------------------------------------------
# 5. Application & System Logs
# -----------------------------------------------------------------------------
*.log
**/*.log
logs/
**/logs/

# Temporary & Swap files
*.tmp
*.bak
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# 6. IDEs & Editors
# -----------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
**/.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/
**/.vscode/
*.code-workspace

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.apt_generated_tests
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# -----------------------------------------------------------------------------
# 7. Operating System Metadata
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
[Dd]esktop.ini
Desktop.ini
Thumbs.db
thumbs.db
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/
