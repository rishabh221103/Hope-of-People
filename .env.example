# =============================================================================
# HOP (Humanitarian Operations Platform) - Environment Variables Template
# Copy this file to .env and replace placeholder values with your credentials.
# =============================================================================

# --- Server & General ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hop_db
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# --- HikariCP Connection Pool ---
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5

# --- JWT Authentication ---
APP_JWT_SECRET=your_base64_encoded_256bit_jwt_secret_key_here
APP_JWT_EXPIRATION_MS=86400000

# --- File & Document Uploads ---
APP_UPLOAD_DIR=uploads/documents
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=100MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=100MB

# --- Video Storage Configuration (HOP Reels) ---
# Provider options: 'local' or 'bunny'
HOP_VIDEO_PROVIDER=local
HOP_VIDEO_LOCAL_DIR=./uploads/reels

# --- Bunny Stream Cloud Storage (Optional / Production) ---
HOP_VIDEO_BUNNY_LIBRARY_ID=
HOP_VIDEO_BUNNY_API_KEY=
HOP_VIDEO_BUNNY_CDN_HOST=

# --- Frontend (Vite) ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api/v1
